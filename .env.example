# Vercel KV (Redis) — from your Vercel KV store dashboard
# Without these the app runs on a local file store (dev only, no cloud sync).
KV_REST_API_URL=
KV_REST_API_TOKEN=

# Vercel Blob — from your Vercel Blob store dashboard
# Without this, uploaded images are stored locally under .data/uploads (dev only).
BLOB_READ_WRITE_TOKEN=

# Google sign-in (optional) — locks the app behind Google accounts and gives
# every account its own private data. Without these the app runs in PUBLIC
# "guest" mode: anyone with the link can view and edit.
# Redirect URI to register in Google Cloud console:
#   https://YOUR-DOMAIN/api/auth/callback/google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Session signing secret (falls back to GOOGLE_CLIENT_SECRET if unset).
SESSION_SECRET=
