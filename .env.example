# Vercel KV (Redis) — from your Vercel KV store dashboard
# Without these the app runs on a local file store (dev only, no cloud sync).
KV_REST_API_URL=
KV_REST_API_TOKEN=

# Vercel Blob — from your Vercel Blob store dashboard
# Without this, uploaded images are stored locally under .data/uploads (dev only).
BLOB_READ_WRITE_TOKEN=
